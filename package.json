{
  "name": "automation-ui-appium-typescript",
  "version": "1.0.0",
  "description": "UI test automation suite for an Android app using Appium, WebdriverIO and Mocha",
  "scripts": {
    "test:smoke": "wdio run wdio.smoke.conf.ts",
    "test:regression": "wdio run wdio.regression.conf.ts",
    "test:e2e": "wdio run wdio.e2e.conf.ts",
    "report": "allure generate allure-results --clean && allure open",
    "report:generate": "allure generate allure-results --clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/types": "^9.0.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.9.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "webdriverio": "^9.0.0"
  }
}
