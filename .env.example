# Android device or emulator serial to target
DEVICE_NAME=emulator-5554

# Path to the APK under test (relative or absolute)
# Must be a debug build (backup export uses adb run-as). CI downloads it to the same path.
APP_PATH=./app/chefplanner-debug.apk

# Appium server address
APPIUM_HOST=localhost
APPIUM_PORT=4723

# Execution environment — affects logging and CI-specific behaviour
# Values: local | ci
WDIO_ENV=local
